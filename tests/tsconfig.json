{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "support/**/*.ts",
    "support/**/*.d.ts",
    "fixtures/**/*.ts"
  ]
}
